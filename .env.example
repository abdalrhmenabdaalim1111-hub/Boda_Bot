# =============================================================================
#  Boda Bot System — .env.example
#  انسخ هذا الملف إلى .env وضع القيم الحقيقية
# =============================================================================

# معرف المطور على تيليجرام
DEVELOPER_CHAT_ID=123456789
ADMIN_CHAT_IDS=123456789,987654321

# توكنات البوتات (احصل عليها من @BotFather)
BOT_STORE_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
BOT_CURRENCY_TOKEN=1234567890:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# إعدادات المتجر
STORE_ADMIN_IDS=123456789
STORE_ADMIN_PASSWORD=your_secure_password_here

# مفاتيح API خارجية
OPENWEATHER_API_KEY=your_api_key_here
EXCHANGE_RATE_API_KEY=your_api_key_here
DEEPL_API_KEY=your_api_key_here

# مفتاح الوصول الخارجي لخادم API (api_server.py)
# مطلوب فقط عند التشغيل بـ --host 0.0.0.0 — اتركه فارغاً للاستخدام المحلي فقط
API_SERVER_KEY=

# قاعدة روابط التطبيقات المصغّرة على GitHub Pages
# يُبنى لكل بوت رابطه: {MINIAPPS_BASE_URL}/{bot_id}/
MINIAPPS_BASE_URL=https://YOUR_USERNAME.github.io/Boda_Bot
